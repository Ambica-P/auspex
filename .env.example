# Copy to .env and fill in. Never commit .env. Never paste keys into chat.
# Empty values count as unset.

# --- Always required ---------------------------------------------------------
# Superuser password of the Postgres container (docker-compose.yml).
POSTGRES_PASSWORD=
# Password of the application role (the role named in DATABASE_URL).
AUSPEX_APP_DB_PASSWORD=
# Application connection: the app role (no UPDATE/DELETE on the ledger).
DATABASE_URL=postgresql+psycopg://auspex_app:<AUSPEX_APP_DB_PASSWORD>@127.0.0.1:5432/auspex
# Migration connection: the superuser (creates roles, runs Alembic).
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:<POSTGRES_PASSWORD>@127.0.0.1:5432/auspex
# Admin bearer token for the REST API; at least 24 characters (openssl rand -hex 24).
ADMIN_TOKEN=
RMF_API_BASE=http://127.0.0.1:8000

# --- Model provider: fake | local | tokenfactory -----------------------------
LLM_PROVIDER=fake
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
# Copy these from the Nebius Token Factory console (do not guess them).
NEBIUS_API_BASE=
NEBIUS_API_KEY=
MODEL_TRIAGE=
MODEL_REASON=
# LLM_THINKING=false        # true: allow Nemotron's reasoning mode (slower)
# LLM_DEBUG=false           # true: log full prompts and answers

# --- Search provider: local | fixtures | tavily ------------------------------
SEARCH_PROVIDER=local
TAVILY_API_KEY=
# Published copy of sim/vendor_site/ (needed for SEARCH_PROVIDER=tavily), e.g.
# https://<github-user>.github.io/auspex-vendors/
VENDOR_SITE_URL=
# TAVILY_RECORD=false       # true: save each live Tavily response as a fixture (final rehearsal)

# --- Optional (defaults in src/auspex/core/config.py) -------------------------
# HORIZON_S=900
# TIE_TOLERANCE_S=30
# STALL_THRESHOLD_S=45
# ETA_SLIP_TOLERANCE_S=60
# APPROVAL_TIMEOUT_S=60
# AUSPEX_CONFIG=A          # A observe only, B deterministic, C + Nemotron; run-scenario sets it
# FAST_LANE_BUDGET_MS=2000
# AGENT_BUDGET_S=30
# TAVILY_CACHE_TTL_S=3600
# RMF_API_TOKEN=
# CORE_HOST=127.0.0.1
# CORE_PORT=8100
# PICTURE_TICK_MS=2000
# LOG_LEVEL=INFO
# LOG_JSON=false
# ROS_SETUP=/opt/ros/kilted/setup.bash
# ROS_OVERLAY_SETUP=/home/<you>/rmf_ws/install/setup.bash
# RMF_SERVER_URI=ws://localhost:8000/_internal
# FASTDDS_BUILTIN_TRANSPORTS=UDPv4   # ROS-side scripts default to UDPv4 (shared memory hung on WSL2)

# --- Decision sandbox (spec 14.6; scripts/run-sandbox, sandbox/Dockerfile) ----
# Off unless enabled. Deployed, it gets its OWN Token Factory key (create a separate key in the
# Nebius console, used only by the sandbox, revoked after 15 December 2026). Never paste keys in chat.
# SANDBOX_NEBIUS_API_KEY=
# SANDBOX_ENABLED=false
# SANDBOX_DAILY_CAP=300
# SANDBOX_RATE_PER_IP_PER_MIN=6
# SANDBOX_MAX_INPUT_CHARS=200
# SANDBOX_BUDGET_USD=0.02            # total model spend allowed for the sandbox (0 = no cap)
# SANDBOX_PRICE_IN_PER_MTOK=         # Nano's input price per million tokens (Nebius console)
# SANDBOX_PRICE_OUT_PER_MTOK=        # Nano's output price per million tokens
# SANDBOX_ALLOWED_ORIGIN=            # only for direct browser calls; the Vercel site calls server-to-server

# --- Tests that touch the database (scripts/test) -----------------------------
# A separate database in the same container; the test drops and recreates it.
TEST_DATABASE_URL=postgresql+psycopg://auspex_app:<AUSPEX_APP_DB_PASSWORD>@127.0.0.1:5432/auspex_test
TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:<POSTGRES_PASSWORD>@127.0.0.1:5432/auspex_test
